# Raw API keys used by docker-compose and the Kestra flows.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Kestra-compatible base64 secrets generated by ./generate_kestra_keys.sh.
SECRET_GEMINI_API_KEY=base64_encoded_gemini_api_key_here
SECRET_OPENAI_API_KEY=base64_encoded_openai_api_key_here
SECRET_TAVILY_API_KEY=base64_encoded_tavily_api_key_here
